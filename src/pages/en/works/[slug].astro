---
import WorkView from '../../../views/WorkView.astro';
import { getWorks } from '../../../i18n/ui';

export async function getStaticPaths() {
  const works = await getWorks('en');
  return works.map((work, index) => ({
    params: { slug: work.slug },
    props: { work, index, next: works[(index + 1) % works.length] },
  }));
}

const { work, index, next } = Astro.props;
---

<WorkView lang="en" work={work} index={index} next={next} />
