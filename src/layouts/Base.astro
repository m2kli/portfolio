---
import { ClientRouter } from 'astro:transitions';
import Analytics from '../components/Analytics.astro';
import Masthead from '../components/Masthead.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { altPath, asset, type Lang } from '../i18n/ui';
// Fonts are self-hosted (Google Fonts is blocked in mainland China and its stylesheet blocks rendering).
// Noto Serif SC is split by unicode-range, so a page only downloads the slices for the characters it shows.
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/noto-serif-sc/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  image?: string;
  active?: 'works' | 'about';
}

const { lang, title, description, image, active } = Astro.props;
const info = site[lang];
const pageTitle = title ? `${title} — ${info.name}` : info.title;
const desc = description ?? info.description;
const otherLang: Lang = lang === 'zh' ? 'en' : 'zh';
const canonical = new URL(Astro.url.pathname, Astro.site);
const alternate = new URL(altPath(lang, Astro.url.pathname), Astro.site);
const ogImage = image ? new URL(asset(image), Astro.site) : undefined;
---

<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={otherLang === 'zh' ? 'zh-CN' : 'en'} href={alternate} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <script is:inline>
      document.documentElement.classList.add('js');
      document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
    </script>
    <Analytics />
    <ClientRouter />
  </head>
  <body>
    <Masthead lang={lang} active={active} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
